{
  "schema_version": 1,
  "events": {
    "project.data_bundle_delivered": {
      "event_schema_version": 1,
      "description": "A paid data order was confirmed delivered by an existing admin completion action or a supplier action that newly returned delivered.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "network",
          "source"
        ],
        "properties": {
          "network": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "supplier_recheck",
              "supplier_fulfillment"
            ]
          }
        }
      }
    }
  }
}
